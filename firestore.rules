rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Auth Helpers ---
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isPartner(resId) {
      return request.auth != null && request.auth.token.restaurantId == resId;
    }

    function isAnyPartner() {
      return request.auth != null && request.auth.token.restaurantId != null;
    }

    function isDeliveryPartner() {
      return request.auth != null && request.auth.token.deliveryPartner == true;
    }

    function isRider() {
      return request.auth != null && request.auth.token.rider == true;
    }

    // --- Restaurants: public read, partners update own, admins full ---
    match /restaurants/{restaurantId} {
      allow read: if true;
      // Partners can edit their own restaurant, but not its featured status or the
      // Payment Partner setup, which an admin enables after checking the UPI details.
      allow update: if isAdmin()
        || (isPartner(restaurantId)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['isFeatured', 'isPaymentPartner', 'upiId', 'upiPayeeName']));
      allow create, delete: if isAdmin();
    }

    // --- Site Content: public read (order settings, banners, grocery settings) ---
    match /site_content/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Laundry Slots: public read ---
    match /laundry_slots/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Laundry Settings: public read (campus config + pricing) ---
    match /laundry_settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users don't need to read their laundry orders (handled via WhatsApp/delivery flow).
    match /laundry_orders/{document} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // --- Orders: NO public read ---
    // Admins: full access
    // Partners: read orders containing their restaurantId; update only WhatsApp ones
    // Delivery partners: read ready_for_delivery orders; claim by updating to picked_up
    // Users: read own orders (by userId)
    // Public: create only, and only WhatsApp orders
    // In-app ("direct") orders are created and changed by the placeDirectOrder /
    // updateDirectOrder Cloud Functions, which price them and check who may act.
    function isDirect(data) {
      return data.get('flow', 'whatsapp') == 'direct';
    }

    match /orders/{orderId} {
      allow create: if !isDirect(request.resource.data);
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
      allow read: if isAnyPartner()
        && request.auth.token.restaurantId in resource.data.restaurantIds;
      allow update: if isAnyPartner()
        && request.auth.token.restaurantId in resource.data.restaurantIds
        && !isDirect(resource.data)
        && !isDirect(request.resource.data);
      allow read: if isDeliveryPartner()
        && resource.data.status in ["ready_for_delivery", "picked_up"];
      allow update: if isDeliveryPartner()
        && resource.data.status == "ready_for_delivery"
        && request.resource.data.status == "picked_up"
        && request.resource.data.deliveryPartnerUid == request.auth.uid;
      allow update: if isDeliveryPartner()
        && resource.data.status == "picked_up"
        && request.resource.data.status == "delivered"
        && resource.data.deliveryPartnerUid == request.auth.uid;
    }

    // --- Counters: public read + guarded bump ---
    // Anonymous checkout runs the order-number transaction, so the write has to be
    // open; the rule pins it to a +1 bump of `last` and nothing else, so a client
    // can burn a number but can't set an arbitrary one or wind the counter back.
    match /counters/{name} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last is int
        && (resource == null
              ? request.resource.data.last == 1
              : request.resource.data.last == resource.data.last + 1);
    }

    // --- Users: own document only (favourites, future prefs) ---
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Payments: customer files one claim per order, admin verifies ---
    // Document id is the order id, and users get create but never update, so a
    // second submission for the same order is refused by the rules rather than
    // relying on the UI to prevent it.
    match /payments/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.orderId == orderId
        && request.resource.data.status == 'pending_verification';
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // --- FCM Tokens: own user only ---
    match /fcm_tokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- Feedback: anyone can send a message, only admins read or triage ---
    match /feedback/{document} {
      allow create: if request.resource.data.keys().hasOnly(['message', 'userId', 'userEmail', 'page', 'status', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'new'
        && (request.resource.data.userId == null
            || (request.auth != null && request.resource.data.userId == request.auth.uid));
      allow read, update, delete: if isAdmin();
    }

    // --- Rides ---
    function isPhone(value) {
      return value is string && value.matches('^[0-9]{10}$');
    }

    function isText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    // Riders: the applicant files and edits their own application, always as
    // `pending`, and only while it is pending or rejected. Approve / reject /
    // revoke go through the manageUsers function, which also sets the claim.
    function isValidRider(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'email', 'name', 'phone', 'vehicleNumber', 'collegeId', 'campusId', 'gender', 'status', 'online', 'ratingSum', 'ratingCount', 'createdAt', 'updatedAt'])
        && d.get('online', false) == false
        // Ratings are the function's to keep; a re-application carries them over untouched.
        && d.get('ratingSum', 0) == (resource == null ? 0 : resource.data.get('ratingSum', 0))
        && d.get('ratingCount', 0) == (resource == null ? 0 : resource.data.get('ratingCount', 0))
        && d.uid == uid
        && d.email == request.auth.token.get('email', null)
        && isText(d.name, 80)
        && isPhone(d.phone)
        && isText(d.vehicleNumber, 20)
        && isText(d.collegeId, 40)
        && isText(d.campusId, 40)
        && isGender(d.gender)
        && d.status == 'pending'
        && d.updatedAt == request.time;
    }

    function isGender(value) {
      return value in ['female', 'male', 'other'];
    }

    // Read from riders/{uid}, so a revoked or offline rider is refused even
    // while their token still carries the `rider` claim.
    function isOnlineRider() {
      let rider = get(/databases/$(database)/documents/riders/$(request.auth.uid)).data;
      return rider.status == 'approved' && rider.get('online', false) == true;
    }

    function isFemaleRider() {
      return get(/databases/$(database)/documents/riders/$(request.auth.uid)).data.get('gender', null) == 'female';
    }

    function isRiderCampus(campusId) {
      return get(/databases/$(database)/documents/riders/$(request.auth.uid)).data.campusId == campusId;
    }

    match /riders/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && isValidRider(uid)
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && resource.data.status in ['pending', 'rejected']
        && isValidRider(uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      // An approved rider goes online / offline from their dashboard, and changes nothing else.
      allow update: if request.auth != null && request.auth.uid == uid
        && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online', 'updatedAt'])
        && request.resource.data.online is bool
        && request.resource.data.updatedAt == request.time;
    }

    // Ride requests: guests book a ride now without logging in, so create is open
    // but pinned to the expected shape. Scheduling needs a signed-in user, so they
    // can follow the ride up. Riders see pending requests booked on their campus
    // on their dashboard; a female-preference request only female riders.
    function isValidSchedule(d) {
      return d.scheduledFor is timestamp
        && d.scheduledFor > request.time
        // Hard cap only: the booking page enforces the admin's window.
        && d.scheduledFor < request.time + duration.value(30, 'd')
        && request.auth != null
        && d.get('userId', null) == request.auth.uid;
    }

    // PickupLocationSchema in lib/schemas/rides.ts.
    function isValidPickupLocation(loc) {
      return loc is map
        && loc.keys().hasOnly(['lat', 'lng', 'accuracy'])
        && loc.lat is number && loc.lat >= -90 && loc.lat <= 90
        && loc.lng is number && loc.lng >= -180 && loc.lng <= 180
        && loc.accuracy is number && loc.accuracy > 0;
    }

    match /ride_requests/{document} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'pickupId', 'pickupName', 'dropId', 'dropName', 'fare', 'status', 'campusId', 'riderPreference', 'passengers', 'pickupLocation', 'userId', 'scheduledFor', 'createdAt'])
        && isText(request.resource.data.name, 80)
        && isPhone(request.resource.data.phone)
        && isText(request.resource.data.pickupId, 64)
        && isText(request.resource.data.pickupName, 80)
        && isText(request.resource.data.dropId, 64)
        && isText(request.resource.data.dropName, 80)
        && request.resource.data.pickupId != request.resource.data.dropId
        // Shape only: the rider sees the fare and settles it on the call.
        && (request.resource.data.fare == null
            || (request.resource.data.fare is int && request.resource.data.fare > 0))
        && request.resource.data.status == 'pending'
        && isText(request.resource.data.campusId, 40)
        && request.resource.data.riderPreference in ['any', 'female']
        // MAX_PASSENGERS in lib/schemas/rides.ts.
        && (!('passengers' in request.resource.data)
            || (request.resource.data.passengers is int
                && request.resource.data.passengers >= 1
                && request.resource.data.passengers <= 2))
        && (!('scheduledFor' in request.resource.data) || isValidSchedule(request.resource.data))
        // A ride now only: where they are when booking isn't where they'll be later.
        && (!('pickupLocation' in request.resource.data)
            || (!('scheduledFor' in request.resource.data)
                && isValidPickupLocation(request.resource.data.pickupLocation)))
        && (!('userId' in request.resource.data)
            || (request.auth != null && request.resource.data.userId == request.auth.uid))
        && request.resource.data.createdAt == request.time;
      // Pending queries must filter campusId and riderPreference to what the rider may see.
      allow read: if isRider()
        && (resource.data.get('riderUid', null) == request.auth.uid
          || (resource.data.status == 'pending'
            && isRiderCampus(resource.data.campusId)
            && (resource.data.riderPreference == 'any' || isFemaleRider())));
      allow read: if request.auth != null && resource.data.get('userId', null) == request.auth.uid;

      // Anyone holding the request id (the guest who booked it) can drop the
      // female-rider preference while it waits, so every rider can take it.
      allow update: if resource.data.status == 'pending'
        && resource.data.get('riderPreference', 'any') == 'female'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riderPreference'])
        && request.resource.data.riderPreference == 'any';

      // The user cancels their ride before it's done: the signed-in owner, or for a
      // guest's ride, anyone holding the request id (kept in the guest's browser).
      allow update: if (resource.data.get('userId', null) == null
          || (request.auth != null && resource.data.userId == request.auth.uid))
        && resource.data.status in ['pending', 'accepted']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time;

      // The signed-in user rates the rider of their completed ride, once.
      // RideRatingSchema in lib/schemas/rides.ts.
      allow update: if request.auth != null
        && resource.data.get('userId', null) == request.auth.uid
        && resource.data.status == 'completed'
        && !('rating' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      // Accept: an approved, online rider takes a pending ride. The transaction in
      // acceptRide plus the `pending` check here make the first rider win.
      allow update: if isRider() && isOnlineRider()
        && resource.data.status == 'pending'
        && (resource.data.get('riderPreference', 'any') == 'any' || isFemaleRider())
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'riderUid', 'riderName', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.riderUid == request.auth.uid
        && isText(request.resource.data.riderName, 80)
        && request.resource.data.acceptedAt == request.time;

      // Confirm a scheduled ride once the sweep has asked: only the rider who accepted it.
      allow update: if isRider()
        && resource.data.status == 'accepted'
        && resource.data.riderUid == request.auth.uid
        && 'confirmRequestedAt' in resource.data
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riderConfirmedAt'])
        && request.resource.data.riderConfirmedAt == request.time;

      // Complete, or release back to pending: only the rider who accepted it.
      allow update: if isRider()
        && resource.data.status == 'accepted'
        && resource.data.riderUid == request.auth.uid
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt'])
              && request.resource.data.status == 'completed'
              && request.resource.data.completedAt == request.time)
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'riderUid', 'riderName', 'acceptedAt', 'confirmRequestedAt', 'riderConfirmedAt'])
              && request.resource.data.status == 'pending'
              && !request.resource.data.keys().hasAny(['riderUid', 'riderName', 'acceptedAt', 'confirmRequestedAt', 'riderConfirmedAt'])));

      allow read, update, delete: if isAdmin();
    }

    // --- Marketplace Requests: public create (seller's sell request), admin-only inbox ---
    match /marketplace_requests/{document} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // --- Marketplace Listings: public read, admin-authored ---
    match /marketplace_listings/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- Catch-all: admin write only, no public read for unlisted collections ---
    match /{document=**} {
      allow write, read: if isAdmin();
    }
  }
}
