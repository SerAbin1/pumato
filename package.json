{
    "name": "pumato",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "dotenv -e .env.test -- next dev",
        "dev:prod": "dotenv -e .env.production -- next dev",
        "build": "dotenv -e .env.production next build",
        "lint": "vp lint",
        "lintfix": "vp lint --fix",
        "format": "vp fmt",
        "deploy": "dotenv -e .env.production pnpm run build && firebase deploy",
        "deploy:rules": "firebase deploy --only firestore:rules,storage",
        "deploy:index": "firebase deploy --only firestore:indexes",
        "deploy:backend": "firebase deploy --only firestore:rules,firestore:indexes,storage",
        "test:e2e": "dotenv -e .env.test -- playwright test",
        "test:ui": "dotenv -e .env.test -- playwright test --ui",
        "test:debug": "dotenv -e .env.test -- playwright test --debug",
        "test:create": "dotenv -e .env.test -- playwright codegen http://localhost:3000",
        "test": "vp test run",
        "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
        "prepare": "vp config"
    },
    "dependencies": {
        "@opentelemetry/api": "^1.9.0",
        "clsx": "^2.1.1",
        "firebase": "^12.8.0",
        "firebase-admin": "^13.6.0",
        "framer-motion": "^12.26.1",
        "fuse.js": "^7.1.0",
        "lucide-react": "^0.562.0",
        "next": "16.3.5",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hot-toast": "^2.6.0",
        "recharts": "^3.8.0",
        "tailwind-merge": "^3.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@tailwindcss/postcss": "^4",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "dotenv-cli": "^11.0.0",
        "firebase-tools": "^15.30.0",
        "jsdom": "^30.0.1",
        "tailwindcss": "^4",
        "typescript": "^7.0.2",
        "vite-plus": "catalog:"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.22.1"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "12.14.0",
            "onFail": "download"
        }
    }
}
